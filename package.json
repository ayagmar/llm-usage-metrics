{
  "name": "llm-usage-metrics",
  "version": "0.14.1",
  "description": "CLI for aggregating local LLM usage metrics from pi, codex, gemini, droid, opencode, openclaw, claude, copilot, goose, amp, qwen, kimi, cline, roocode, kilocode, antigravity, and deepseek harness sessions",
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=22.16 <23 || >=24"
  },
  "bin": {
    "llm-usage": "dist/bin.js",
    "llm-usage-metrics": "dist/bin.js"
  },
  "files": [
    "dist/bin.js",
    "dist/index.js",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/cli/index.ts src/cli/bin.ts --format esm --clean --sourcemap --minify",
    "cli": "tsx src/cli/index.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/share-report/client/tsconfig.json",
    "test": "vitest run --coverage",
    "test:watch": "vitest --coverage.enabled=false",
    "test:fast": "vitest run --coverage.enabled=false",
    "core:build": "pnpm --filter @ayagmar/agent-sessions run build",
    "core:typecheck": "pnpm --filter @ayagmar/agent-sessions run typecheck",
    "core:test": "pnpm --filter @ayagmar/agent-sessions run test",
    "core:lint": "pnpm --filter @ayagmar/agent-sessions run lint",
    "core:test:fast": "pnpm --filter @ayagmar/agent-sessions run test:fast",
    "core:test:memory": "pnpm --filter @ayagmar/agent-sessions run test:memory",
    "core:pack:check": "node scripts/check-core-pack.mjs",
    "core:version": "changeset version",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "verify": "pnpm run lint && pnpm run typecheck && pnpm run core:typecheck && pnpm run test && node .github/scripts/check-coverage-threshold.mjs && pnpm run core:test && node .github/scripts/check-coverage-threshold.mjs packages/core/coverage/coverage-summary.json && pnpm run format:check",
    "verify:full": "pnpm run build && pnpm run dist:size && pnpm run verify",
    "verify:ci": "pnpm run verify && pnpm run docs:mermaid:validate && pnpm run build && pnpm run dist:size && pnpm run smoke:dist-opencode && pnpm run smoke:sqlite-warning && pnpm run pack:check && pnpm --filter llm-usage-metrics-site run format:check && pnpm run site:check && pnpm run site:docs:generate -- --rebuild && git diff --exit-code -- site/src/content/docs/cli-reference.mdx site/src/content/docs/security.mdx && pnpm run site:build && pnpm run site:links",
    "pack:check": "npm pack",
    "dist:size": "node scripts/check-dist-size.mjs",
    "pricing:snapshot": "node scripts/generate-pricing-snapshot.mjs",
    "smoke:dist-opencode": "node scripts/smoke-dist-opencode.mjs",
    "smoke:dist-bun": "node scripts/smoke-dist-bun.mjs",
    "smoke:sqlite-warning": "node scripts/smoke-sqlite-warning.mjs",
    "perf:report-baseline": "node --import tsx scripts/perf-report-baseline.mjs",
    "perf:warm-query": "node --import tsx scripts/perf-warm-query-benchmark.mjs",
    "perf:production-benchmark": "node scripts/perf-production-benchmark.mjs",
    "release": "release-it",
    "release:dry": "release-it --dry-run",
    "release:ci": "release-it --ci",
    "site:dev": "pnpm --filter llm-usage-metrics-site dev",
    "site:build": "pnpm --filter llm-usage-metrics-site build",
    "site:preview": "pnpm --filter llm-usage-metrics-site preview",
    "site:check": "pnpm --filter llm-usage-metrics-site check",
    "site:links": "node site/scripts/check-links.mjs",
    "site:docs:generate": "node scripts/generate-cli-reference.mjs && node scripts/generate-site-security-doc.mjs",
    "docs:mermaid:validate": "node scripts/validate-mermaid.mjs",
    "docs:screenshots": "node site/scripts/docs-screenshots.mjs",
    "bench:baseline": "node scripts/benchmark-baseline.mjs"
  },
  "keywords": [
    "llm",
    "usage",
    "cli",
    "pi",
    "codex",
    "gemini",
    "droid",
    "factory",
    "opencode",
    "openclaw",
    "claude",
    "copilot",
    "goose",
    "amp",
    "qwen",
    "kimi",
    "cline",
    "roocode",
    "kilocode",
    "antigravity",
    "dsh",
    "deepseek"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ayagmar/llm-usage-metrics"
  },
  "bugs": {
    "url": "https://github.com/ayagmar/llm-usage-metrics/issues"
  },
  "homepage": "https://ayagmar.github.io/llm-usage-metrics/",
  "dependencies": {
    "commander": "15.0.0",
    "markdown-table": "3.0.4",
    "picocolors": "1.1.1"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@eslint/js": "10.0.1",
    "@release-it/conventional-changelog": "12.0.2",
    "@types/node": "26.6.5",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/coverage-v8": "5.0.5",
    "ajv": "8.20.0",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-redos": "4.6.1",
    "eslint-plugin-regexp": "3.3.1",
    "prettier": "3.9.10",
    "release-it": "21.1.1",
    "smol-toml": "1.9.1",
    "tsup": "9.0.0",
    "tsx": "4.23.15",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
