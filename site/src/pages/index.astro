---
import {
  getDefaultSourceIds,
  getSourceStorageFormat,
} from '../../../src/sources/create-default-adapters';
import { version } from '../../../package.json';
import '../styles/tokens.css';

const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const link = (slug: string) => `${base}${slug}/`;
const github = 'https://github.com/ayagmar/llm-usage-metrics';
const sources = getDefaultSourceIds();
const reports = [
  {
    name: 'Summary',
    command: '',
    question: 'How am I doing this month?',
    detail:
      'Today, the last 7 days, and the month at a glance, with your streak and a month-end projection.',
    slug: 'usage',
  },
  {
    name: 'Usage',
    command: 'monthly',
    question: 'Where did the tokens go?',
    detail:
      'Daily, weekly, and monthly totals by source, with model breakdowns and estimated cost.',
    slug: 'usage',
  },
  {
    name: 'Compare',
    command: 'compare',
    question: 'What changed this month?',
    detail: 'Compare two periods with tokens, cost, events, and active days side by side.',
    slug: 'compare',
  },
  {
    name: 'Sessions',
    command: 'session --top 10',
    question: 'Which work used the most?',
    detail: 'Rank conversations by cost or group usage by repository.',
    slug: 'session',
  },
  {
    name: 'Trends',
    command: 'trends --metric tokens --days 14',
    question: 'Is usage climbing?',
    detail: 'Inspect a daily series over a chosen window, combined or split by source.',
    slug: 'trends',
  },
  {
    name: 'Status line',
    command: 'statusline',
    question: 'What is this session costing?',
    detail:
      'Today, your streak, and the month in Claude Code, tmux, or starship, plus the session cost in Claude Code.',
    slug: 'statusline',
  },
];
const machineRows = [
  { label: 'claude (local)', tokens: '18,240,000', cost: '$96.10' },
  { label: 'claude (laptop)', tokens: '9,880,000', cost: '$51.37' },
  { label: 'codex (devbox)', tokens: '6,410,000', cost: '$14.82' },
  { label: 'TOTAL', tokens: '34,530,000', cost: '$162.29' },
];
const examples = [
  {
    id: 'usage',
    title: 'Monthly usage',
    command: 'llm-usage monthly --source codex,claude',
    heading: 'Usage by source',
    rows: [
      { label: 'codex', tokens: '8,420,000', cost: '$18.42' },
      { label: 'claude', tokens: '6,180,000', cost: '~$24.16' },
      { label: 'ALL', tokens: '14,600,000', cost: '~$42.58' },
    ],
    note: 'A tilde marks partial cost. Unpriced events still count toward token totals.',
    slug: 'pricing',
  },
  {
    id: 'sessions',
    title: 'Top sessions',
    command: 'llm-usage session --top 3',
    heading: 'Sessions ranked by cost',
    rows: [
      { label: 'claude / session-a', tokens: '2,310,000', cost: '$9.84' },
      { label: 'codex / session-b', tokens: '1,820,000', cost: '$4.62' },
      { label: 'codex / session-c', tokens: '940,000', cost: '$2.18' },
    ],
    note: 'Switch to session --by-repo to group the same history by repository.',
    slug: 'session',
  },
  {
    id: 'export',
    title: 'Export',
    command: 'llm-usage daily --json > usage.json',
    heading: 'Versioned JSON for your scripts',
    rows: [],
    note: 'Report data goes to stdout. Diagnostics stay on stderr.',
    slug: 'output-formats',
  },
];
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content={`Track tokens, estimated cost, and sessions across ${sources.length} AI coding tools on all your machines. Read the logs on your disks, compare reports, and export your data.`}
    />
    <meta name="theme-color" content="#11130f" />
    <meta property="og:title" content="LLM Usage Metrics — your agents, accounted for" />
    <meta
      property="og:description"
      content="One usage history for your AI coding tools, across all your machines. Tokens, estimated cost, sessions, and exports."
    />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={new URL(`${base}og.png`, Astro.site)} />
    <meta property="og:image:width" content="1280" />
    <meta property="og:image:height" content="640" />
    <meta
      property="og:image:alt"
      content="llm-usage-metrics: a monthly cost report across claude, codex, gemini, and pi, from three machines over ssh."
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={new URL(`${base}og.png`, Astro.site)} />
    <meta property="og:url" content={new URL(base, Astro.site)} />
    <link rel="canonical" href={new URL(base, Astro.site)} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <title>LLM Usage Metrics — your agents, accounted for</title>
    <script is:inline>
      try {
        const saved = localStorage.getItem('starlight-theme');
        document.documentElement.dataset.theme =
          saved === 'light' || saved === 'dark'
            ? saved
            : matchMedia('(prefers-color-scheme: light)').matches
              ? 'light'
              : 'dark';
      } catch {
        /* Keep the default theme when storage is unavailable. */
      }
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <header class="header shell">
      <a class="brand" href={base}>
        <img src={`${base}favicon.svg`} width="30" height="30" alt="" />
        <span>
          llm-usage<span class="brand-suffix">-metrics</span>
        </span>
      </a>
      <nav aria-label="Main navigation">
        <a href={link('docs')}>Docs</a>
        <a href={link('sources')}>Sources</a>
        <a class="github-link" href={github}>
          GitHub <span aria-hidden="true">↗</span>
        </a>
        <button class="theme-toggle" type="button" aria-label="Use light theme" data-theme-toggle>
          <span aria-hidden="true">◐</span>
        </button>
      </nav>
    </header>

    <main id="main" class="shell">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-copy">
          <a class="release" href={`${github}/releases`}>
            <span aria-hidden="true">●</span> v{version} <span class="muted">/ open source</span>{' '}
            <span aria-hidden="true">↗</span>
          </a>
          <p class="eyebrow">Your agents, accounted for</p>
          <h1 id="hero-title">
            Follow the work.
            <br />
            <em>Count the tokens.</em>
          </h1>
          <p class="summary">
            One usage history for {sources.length} AI coding tools, across every machine you work
            on. Read the logs already on your disks to see tokens, estimated cost, and the sessions
            behind them.
          </p>
          <div class="actions">
            <a class="button primary" href={link('getting-started')}>
              Get your first report <span aria-hidden="true">→</span>
            </a>
            <a class="text-link" href={link('reports')}>
              Explore the reports
            </a>
          </div>
          <div class="install">
            <code>npm install -g llm-usage-metrics</code>
            <button
              type="button"
              data-copy="npm install -g llm-usage-metrics"
              aria-label="Copy install command"
            >
              Copy
            </button>
          </div>
          <p class="setup-note">
            Node.js 22.16+ or 24+, or Bun <span aria-hidden="true">·</span> macOS, Linux, Windows{' '}
            <span aria-hidden="true">·</span> MIT
          </p>
        </div>
        <div class="report-preview">
          <div class="window-bar">
            <span class="window-dot" aria-hidden="true"></span>
            <span>~/usage</span>
            <span class="sample-label">Illustrative data</span>
          </div>
          <div class="preview-controls" aria-label="Choose a report preview">
            {examples.map((example, i) => (
              <button
                type="button"
                data-preview={example.id}
                aria-pressed={i === 0}
                aria-controls={`preview-${example.id}`}
              >
                {example.title}
              </button>
            ))}
          </div>
          {examples.map((example, i) => (
            <section
              id={`preview-${example.id}`}
              class="preview-panel"
              hidden={i !== 0}
              aria-label={example.title}
            >
              <p class="command">
                <span aria-hidden="true">❯</span> <code>{example.command}</code>
              </p>
              <h2>{example.heading}</h2>
              {example.id === 'export' ? (
                <pre><code>{`{\n  "schemaVersion": 1,\n  "report": "usage",\n  "data": []\n}`}</code></pre>
              ) : (
                <table>
                  <thead>
                    <tr>
                      <th scope="col">{example.id === 'usage' ? 'Source' : 'Session'}</th>
                      <th scope="col">Tokens</th>
                      <th scope="col">Cost (USD)</th>
                    </tr>
                  </thead>
                  <tbody>
                    {example.rows.map((row) => (
                      <tr>
                        <th scope="row">{row.label}</th>
                        <td>{row.tokens}</td>
                        <td>{row.cost}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              )}
              <p class="preview-note">{example.note}</p>
              <a class="text-link" href={link(example.slug)}>
                Read the guide <span aria-hidden="true">→</span>
              </a>
            </section>
          ))}
          <div class="window-footer">
            <span class="status-dot" aria-hidden="true"></span>Session content stays local
            <span class="muted">/ no account needed</span>
          </div>
        </div>
      </section>

      <section class="sources-strip" aria-labelledby="sources-title">
        <div>
          <p class="eyebrow">Works across your toolchain</p>
          <h2 id="sources-title">
            {sources.length} sources.
            <br />
            One reporting language.
          </h2>
          <a class="text-link" href={link('sources')}>
            Check paths &amp; setup →
          </a>
        </div>
        <ul>
          {sources.map((source) => (
            <li>
              <a href={link(`sources/${source}`)}>
                {source}
                <span>{getSourceStorageFormat(source)}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>

      <section class="section machines" aria-labelledby="machines-title">
        <div>
          <p class="eyebrow">Every machine, one history</p>
          <h2 id="machines-title">Your laptop, your desktop, your dev box. One report.</h2>
          <p>
            Add a machine you can reach over ssh and its usage joins every report. Each machine
            parses its own logs; a session that reached two of them through a synced folder counts
            once.
          </p>
          <p>
            Usage also outlives the logs. Tools delete old transcripts, but the local ledger keeps
            what they counted, so last quarter still adds up.
          </p>
          <a class="text-link" href={link('machines')}>
            Set up machines →
          </a>
        </div>
        <div class="report-preview flat">
          <div class="window-bar">
            <span class="window-dot" aria-hidden="true"></span>
            <span>~/usage</span>
            <span class="sample-label">Illustrative data</span>
          </div>
          <div class="preview-panel">
            <p class="command">
              <span aria-hidden="true">❯</span> <code>llm-usage machine add laptop</code>
            </p>
            <p class="command">
              <span aria-hidden="true">❯</span> <code>llm-usage monthly --by-machine</code>
            </p>
            <table>
              <thead>
                <tr>
                  <th scope="col">Source</th>
                  <th scope="col">Tokens</th>
                  <th scope="col">Cost (USD)</th>
                </tr>
              </thead>
              <tbody>
                {machineRows.map((row) => (
                  <tr>
                    <th scope="row">{row.label}</th>
                    <td>{row.tokens}</td>
                    <td>{row.cost}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <section class="section" aria-labelledby="reports-title">
        <div class="section-heading">
          <div>
            <p class="eyebrow">Ask a better question</p>
            <h2 id="reports-title">Start with what you want to know.</h2>
          </div>
          <a class="text-link" href={link('reports')}>
            All reports →
          </a>
        </div>
        <div class="report-grid">
          {reports.map((report) => (
            <a class="report-card" href={link(report.slug)}>
              <div class="card-top">
                <span class="eyebrow">{report.name}</span>
                <span aria-hidden="true">↗</span>
              </div>
              <h3>{report.question}</h3>
              <p>{report.detail}</p>
              <code>{report.command ? `llm-usage ${report.command}` : 'llm-usage'}</code>
            </a>
          ))}
        </div>
        <p class="more-reports">
          Does usage line up with your commits? <a href={link('efficiency')}>Check efficiency</a>.
          Want a year in review? <a href={link('wrapped')}>Try Wrapped</a>. Need individual events?{' '}
          <a href={link('events')}>Export JSONL or CSV</a>.
        </p>
      </section>

      <section class="section principles" aria-labelledby="principles-title">
        <div>
          <p class="eyebrow">Know what you’re measuring</p>
          <h2 id="principles-title">
            Useful numbers.
            <br />
            Visible limits.
          </h2>
          <p class="summary">
            Usage reports help you understand your tools. Source logs, pricing coverage, and
            attribution determine what each number can tell you.
          </p>
          <a class="text-link" href={link('pricing')}>
            How pricing works →
          </a>
        </div>
        <dl>
          <div>
            <dt>
              <span>01</span> Your sessions stay on your machines
            </dt>
            <dd>
              Parsing and reporting happen on your machines, and other machines are reached only
              over your own ssh. Online runs fetch pricing and check npm for updates; neither
              request includes your usage. <a href={link('privacy')}>Read the privacy page</a>.
            </dd>
          </div>
          <div>
            <dt>
              <span>02</span> Cost coverage is explicit
            </dt>
            <dd>
              Source-recorded cost is kept. Other events use available model pricing. A tilde marks
              partial cost; a dash means unresolved cost. Estimates may differ from your bill.
            </dd>
          </div>
          <div>
            <dt>
              <span>03</span> Keep the data useful outside the terminal
            </dt>
            <dd>
              Export versioned JSON, Markdown, normalized events, or supported share SVGs.
              Diagnostics stay separate from report data.{' '}
              <a href={link('output-formats')}>Choose an output format</a>.
            </dd>
          </div>
        </dl>
      </section>

      <section class="section quickstart" aria-labelledby="quickstart-title">
        <div>
          <p class="eyebrow">From logs to a report</p>
          <h2 id="quickstart-title">Your first report is one command away.</h2>
          <p>Try it without installing. Standard source locations are discovered automatically.</p>
          <a class="button primary" href={link('getting-started')}>
            Open the setup guide →
          </a>
        </div>
        <div class="quickstart-code">
          <span class="eyebrow">Try it now</span>
          <div class="install">
            <code>npx --yes llm-usage-metrics@latest</code>
            <button
              type="button"
              data-copy="npx --yes llm-usage-metrics@latest"
              aria-label="Copy quickstart command"
            >
              Copy
            </button>
          </div>
          <p>Already installed, but seeing an empty report?</p>
          <code>llm-usage doctor</code>
          <a class="text-link" href={link('troubleshooting')}>
            Find the cause →
          </a>
        </div>
      </section>
      <p class="sr-only" role="status" data-copy-status></p>
    </main>
    <footer class="shell footer">
      <a class="brand" href={base}>
        llm-usage-metrics
      </a>
      <nav aria-label="Footer">
        <a href={link('docs')}>Documentation</a>
        <a href={link('cli-reference')}>CLI reference</a>
        <a href={link('privacy')}>Privacy</a>
        <a href={`${base}llms.txt`}>llms.txt</a>
        <a href={link('benchmarks')}>Benchmarks</a>
        <a href={github}>GitHub</a>
        <a href="https://www.npmjs.com/package/llm-usage-metrics">npm</a>
      </nav>
      <p>Built for the logs you already have. MIT licensed.</p>
    </footer>

    <script>
      const toggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
      function updateThemeControl() {
        const dark = document.documentElement.dataset.theme === 'dark';
        toggle?.setAttribute('aria-label', dark ? 'Use light theme' : 'Use dark theme');
        document
          .querySelector('meta[name="theme-color"]')
          ?.setAttribute('content', dark ? '#11130f' : '#f5f2ea');
      }
      toggle?.addEventListener('click', () => {
        const theme = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = theme;
        try {
          localStorage.setItem('starlight-theme', theme);
        } catch {
          /* Theme still works without storage. */
        }
        updateThemeControl();
      });
      updateThemeControl();
      for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
        let timeout: ReturnType<typeof setTimeout>;
        button.addEventListener('click', async () => {
          const status = document.querySelector('[data-copy-status]');
          try {
            await navigator.clipboard.writeText(button.dataset.copy!);
            button.textContent = 'Copied';
            if (status) status.textContent = 'Command copied.';
          } catch {
            button.textContent = 'Try selecting';
            if (status) status.textContent = 'Unable to copy. Select and copy the command text.';
          }
          clearTimeout(timeout);
          timeout = setTimeout(() => {
            button.textContent = 'Copy';
          }, 2500);
        });
      }
      const controls = document.querySelectorAll<HTMLButtonElement>('[data-preview]');
      for (const button of controls) {
        button.addEventListener('click', () => {
          for (const control of controls)
            control.setAttribute('aria-pressed', String(control === button));
          for (const panel of document.querySelectorAll<HTMLElement>('.preview-panel'))
            panel.hidden = panel.id !== `preview-${button.dataset.preview}`;
        });
      }
    </script>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }
  :global(html) {
    color-scheme: dark;
    scroll-behavior: smooth;
    background: var(--color-bg);
  }
  :global(html[data-theme='light']) {
    color-scheme: light;
  }
  :global(body) {
    margin: 0;
    color: var(--color-text);
    font-family: var(--font-sans);
    line-height: 1.6;
  }
  :global(::selection) {
    background: var(--color-accent-subtle);
  }
  :global(:focus-visible) {
    outline: 2px solid var(--color-accent);
    outline-offset: 5px;
  }
  a {
    color: inherit;
    text-decoration: none;
  }
  button {
    font: inherit;
    cursor: pointer;
  }
  .shell {
    max-width: 1280px;
    margin-inline: auto;
    padding-inline: clamp(1.25rem, 4vw, 3rem);
  }
  .header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    min-height: 90px;
    gap: 1rem;
    border-bottom: 1px solid var(--border-default);
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    font-family: var(--font-mono);
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: -0.03em;
  }
  nav {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    font-size: 0.86rem;
    color: var(--color-text-muted);
  }
  nav a:hover,
  .text-link:hover {
    color: var(--color-accent-hover);
  }
  .theme-toggle {
    width: 40px;
    height: 40px;
    border: 1px solid var(--border-default);
    border-radius: 50%;
    background: var(--color-bg-card);
    color: var(--color-text);
    font-size: 1.4rem;
  }
  .skip-link {
    position: fixed;
    top: 1rem;
    left: 1rem;
    z-index: 10;
    padding: 0.7rem 1rem;
    background: var(--color-accent);
    color: var(--color-accent-ink);
    transform: translateY(-200%);
  }
  .skip-link:focus {
    transform: none;
  }
  .hero {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3.5rem;
    align-items: center;
    padding-block: 5rem 4.5rem;
  }
  .release {
    display: inline-flex;
    gap: 0.6rem;
    align-items: center;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    border-bottom: 1px solid var(--border-strong);
    padding-bottom: 0.5rem;
    margin-bottom: 2.2rem;
  }
  .release > span:first-child {
    color: var(--color-accent);
    font-size: 0.6rem;
  }
  .eyebrow {
    margin: 0 0 1rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }
  h1 {
    margin: 0;
    font-size: clamp(2.7rem, 4.8vw, 4.4rem);
    letter-spacing: -0.065em;
    line-height: 1.06;
    font-weight: 500;
  }
  h1 em {
    color: var(--color-accent);
    font-style: normal;
  }
  .summary {
    max-width: 45ch;
    color: var(--color-text-muted);
    font-size: 1.08rem;
    margin-block: 1.6rem;
  }
  .actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.4rem;
    margin-block: 2rem;
  }
  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    padding: 0.8rem 1.15rem;
    border: 1px solid transparent;
    border-radius: 0.35rem;
    font-size: 0.86rem;
    font-weight: 600;
    transition: background 150ms;
  }
  .primary {
    background: var(--color-accent);
    color: var(--color-accent-ink);
  }
  .primary:hover {
    background: var(--color-accent-hover);
  }
  .text-link {
    font-size: 0.83rem;
    font-weight: 500;
    text-decoration: underline;
    text-underline-offset: 0.3em;
    text-decoration-color: var(--border-strong);
  }
  .install {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.65rem 0.65rem 0.65rem 1rem;
    background: var(--color-bg-code);
    border: 1px solid var(--border-strong);
    border-radius: 0.35rem;
  }
  code,
  pre {
    font-family: var(--font-mono);
  }
  .install code {
    font-size: 0.76rem;
    overflow-wrap: anywhere;
    flex: 1;
  }
  .install button {
    border: 1px solid var(--border-strong);
    background: var(--color-bg-elevated);
    color: var(--color-text-secondary);
    border-radius: 0.2rem;
    padding: 0.45rem 0.65rem;
    font-size: 0.7rem;
    min-height: 36px;
  }
  .setup-note {
    font-size: 0.7rem;
    color: var(--color-text-muted);
    margin-top: 0.8rem;
