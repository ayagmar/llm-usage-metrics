---
import { Image } from 'astro:assets';
import {
  getDefaultSourceIds,
  getSourceStorageFormat,
} from '../../../src/sources/create-default-adapters';
import { version } from '../../../package.json';
import EventFlow from '../components/diagrams/EventFlow.astro';
import PackageLayers from '../components/diagrams/PackageLayers.astro';
import projectsShot from '../assets/screenshots/term-projects.webp';
import summaryShot from '../assets/screenshots/term-summary.webp';
import '../styles/tokens.css';

const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const link = (slug: string) => `${base}${slug}/`;
const github = 'https://github.com/ayagmar/llm-usage-metrics';
const demoReport = `${base}demo/report.html`;
const demoTitle =
  'Demo interactive report: 90 days of generated usage across four sources and four projects';
const sources = getDefaultSourceIds();
const reports = [
  {
    name: 'Summary',
    command: '',
    question: 'How am I doing this month?',
    detail:
      'Today, the last 7 days, and the month at a glance, with your streak and a month-end projection.',
    slug: 'usage',
  },
  {
    name: 'Usage',
    command: 'daily',
    question: 'Where did the tokens go?',
    detail:
      'Hourly, daily, weekly, and monthly totals by source, with model breakdowns and estimated cost.',
    slug: 'usage',
  },
  {
    name: 'Projects',
    command: 'projects',
    question: 'Which project costs the most?',
    detail: 'Every project in your history, costliest first, with its models and active days.',
    slug: 'projects',
  },
  {
    name: 'Sessions',
    command: 'session --top 10',
    question: 'Which conversations used the most?',
    detail: 'Rank sessions by cost, or group them into one row per project.',
    slug: 'session',
  },
  {
    name: 'Compare',
    command: 'compare',
    question: 'What changed this month?',
    detail: 'Two periods side by side: tokens, cost, events, and active days, with the deltas.',
    slug: 'compare',
  },
  {
    name: 'Trends',
    command: 'trends --metric tokens --last 14',
    question: 'Is usage climbing?',
    detail: 'A daily series over a chosen window, combined, by source, or by project.',
    slug: 'trends',
  },
  {
    name: '5-hour blocks',
    command: 'blocks',
    question: 'How much of this window is left?',
    detail: 'Estimated 5-hour windows per source, with the active block’s time left and burn rate.',
    slug: 'blocks',
  },
  {
    name: 'Plan value',
    command: 'value',
    question: 'Is the subscription worth it?',
    detail: 'Each month priced at API rates next to a plan’s monthly price, split by project.',
    slug: 'value',
  },
  {
    name: 'Status line',
    command: 'statusline',
    question: 'What is this session costing?',
    detail:
      'Today, your streak, and the month in Claude Code, tmux, or starship, plus the session cost in Claude Code.',
    slug: 'statusline',
  },
];
const machineRows = [
  { label: 'claude (local)', tokens: '18,240,000', cost: '$96.10' },
  { label: 'claude (laptop)', tokens: '9,880,000', cost: '$51.37' },
  { label: 'codex (devbox)', tokens: '6,410,000', cost: '$14.82' },
  { label: 'TOTAL', tokens: '34,530,000', cost: '$162.29' },
];
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content={`Tokens, estimated cost, projects, and sessions for ${sources.length} AI coding agents, across all your machines. Reads the logs on your disks and opens any report as an interactive page.`}
    />
    <meta name="theme-color" content="#11130f" />
    <meta property="og:title" content="LLM Usage Metrics — your agents, accounted for" />
    <meta
      property="og:description"
      content={`One usage history for ${sources.length} AI coding agents, across all your machines. Tokens, estimated cost, projects, sessions, and an interactive report.`}
    />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={new URL(`${base}og.png`, Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="llm-usage-metrics: a projects report ranking four projects by cost, and the command that writes the interactive HTML report."
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={new URL(`${base}og.png`, Astro.site)} />
    <meta property="og:url" content={new URL(base, Astro.site)} />
    <link rel="canonical" href={new URL(base, Astro.site)} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <title>LLM Usage Metrics — your agents, accounted for</title>
    <script is:inline>
      try {
        const saved = localStorage.getItem('starlight-theme');
        document.documentElement.dataset.theme =
          saved === 'light' || saved === 'dark'
            ? saved
            : matchMedia('(prefers-color-scheme: light)').matches
              ? 'light'
              : 'dark';
      } catch {
        /* Keep the default theme when storage is unavailable. */
      }
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <header class="header shell">
      <a class="brand" href={base}>
        <img src={`${base}favicon.svg`} width="30" height="30" alt="" />
        <span>
          llm-usage<span class="brand-suffix">-metrics</span>
        </span>
      </a>
      <nav aria-label="Main navigation">
        <a href={link('docs')}>Docs</a>
        <a href={link('sources')}>Sources</a>
        <a class="github-link" href={github}>
          GitHub <span aria-hidden="true">↗</span>
        </a>
        <button class="theme-toggle" type="button" aria-label="Use light theme" data-theme-toggle>
          <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true">
            <circle
              cx="10"
              cy="10"
              r="7.25"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
            ></circle>
            <path d="M10 2.75a7.25 7.25 0 0 1 0 14.5z" fill="currentColor"></path>
          </svg>
        </button>
      </nav>
    </header>

    <main id="main" class="shell">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-copy">
          <a class="release" href={`${github}/releases`}>
            <span aria-hidden="true">●</span> v{version} <span class="muted">/ open source</span>{' '}
            <span aria-hidden="true">↗</span>
          </a>
          <h1 id="hero-title">
            Follow the work.
            <br />
            <em>Count the tokens.</em>
          </h1>
          <p class="summary">
            One CLI for the session logs of {sources.length} AI coding agents. See tokens and
            estimated cost by day, project, and session, across every machine you work on, and open
            any report as an interactive page.
          </p>
          <div class="actions">
            <a class="button primary" href={link('getting-started')}>
              Get your first report <span aria-hidden="true">→</span>
            </a>
            <a class="text-link" href="#live-report">
              Try the demo report
            </a>
          </div>
          <div class="install">
            <code>npm install -g llm-usage-metrics</code>
            <button
              type="button"
              data-copy="npm install -g llm-usage-metrics"
              aria-label="Copy install command"
            >
              Copy
            </button>
          </div>
          <p class="setup-note">
            Node.js 22.16+ or 24+, or Bun <span aria-hidden="true">·</span> macOS, Linux, Windows{' '}
            <span aria-hidden="true">·</span> MIT
          </p>
        </div>
        <figure class="hero-shot">
          <Image
            src={summaryShot}
            widths={[520, summaryShot.width]}
            sizes="(max-width: 800px) 100vw, 520px"
            loading="eager"
            fetchpriority="high"
            alt="Terminal output of llm-usage summary: cost, tokens, and top source for today, the last 7 days, and month to date, a month-end projection and caching savings, then streaks and a year-long activity heatmap."
          />
          <figcaption>
            <code>llm-usage</code> on demo data
          </figcaption>
        </figure>
      </section>

      <section class="sources-strip" aria-labelledby="sources-title">
        <div>
          <h2 id="sources-title">
            {sources.length} agents. <br />
            One reporting language.
          </h2>
          <p>
            Each tool’s logs are read in place and turned into the same events, so every report
            covers all of them.
          </p>
          <a class="text-link" href={link('sources')}>
            Check paths &amp; setup →
          </a>
        </div>
        <ul>
          {sources.map((source) => (
            <li>
              <a href={link(`sources/${source}`)}>
                {source}
                <span>{getSourceStorageFormat(source)}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>

      <section class="section projects" aria-labelledby="projects-title">
        <div class="projects-copy">
          <h2 id="projects-title">See which project the tokens went to.</h2>
          <p>
            Every session records the folder it ran in. <code>llm-usage projects</code> ranks those
            projects by cost, with their models, share of the cost, events, and active days.
          </p>
          <ul class="command-list">
            <li>
              <code>--by-repo</code>
              <span>
                splits hourly, daily, weekly, monthly, compare, session, and trends by project
              </span>
            </li>
            <li>
              <code>--repo atlas-api</code>
              <span>keeps one project in most reports, by name or by path</span>
            </li>
            <li>
              <code>llm-usage value</code>
              <span>shows each month’s projects next to your subscription’s price</span>
            </li>
          </ul>
          <a class="text-link" href={link('projects')}>
            How projects are named →
          </a>
        </div>
        <figure class="shot" tabindex="0" role="region" aria-label="llm-usage projects output">
          <Image
            src={projectsShot}
            widths={[720, projectsShot.width]}
            sizes="(max-width: 800px) 100vw, 720px"
            alt="Terminal output of llm-usage projects: four projects ranked by cost, each with its models, cost, share of the cost, tokens, events, and active days, and a TOTAL row."
          />
        </figure>
      </section>

      <section class="section live" id="live-report" aria-labelledby="live-title">
        <div class="section-heading">
          <div>
            <h2 id="live-title">Open any report as an interactive page.</h2>
            <p>
              Add <code>--share</code> to summary, daily, weekly, monthly, compare, trends, wrapped,
              efficiency, or optimize. The CLI writes one HTML file you can filter by source, model,
              and project, regroup by hour, day, week, or month, and export chart by chart. The file
              loads nothing from the network, and <code>--redact</code> replaces project and machine
              names before you send it on.
            </p>
          </div>
          <a class="text-link" href={link('share')}>
            What the page offers →
          </a>
        </div>
        <figure class="live-figure">
          <div class="live-frame">
            <iframe
              title={demoTitle}
              loading="lazy"
              data-demo-report
              data-src={demoReport}
            ></iframe>
            <noscript>
              <iframe src={demoReport} title={demoTitle} loading="lazy"></iframe>
            </noscript>
          </div>
          <figcaption>
            <span>
              <code>llm-usage daily --last 90 --share</code> on generated demo data: four sources,
              four projects, 90 days.
            </span>
            <a class="text-link" href={demoReport}>
              Open it full page <span aria-hidden="true">↗</span>
            </a>
          </figcaption>
        </figure>
      </section>

      <section class="section machines" aria-labelledby="machines-title">
        <div>
          <h2 id="machines-title">Your laptop, your desktop, your dev box. One report.</h2>
          <p>
            Add a machine you can reach over ssh and its usage joins every report. Each machine
            parses its own logs; a session that reached two of them through a synced folder counts
            once.
          </p>
          <p>
            Usage also outlives the logs. Tools delete old transcripts, but the local ledger keeps
            what they counted, so last quarter still adds up.
          </p>
          <a class="text-link" href={link('machines')}>
            Set up machines →
          </a>
        </div>
        <div class="report-preview">
          <div class="window-bar">
            <span class="window-dot" aria-hidden="true"></span>
            <span>~/usage</span>
            <span class="sample-label">Illustrative data</span>
          </div>
          <div class="preview-panel">
            <p class="command">
              <span aria-hidden="true">❯</span> <code>llm-usage machine add laptop</code>
            </p>
            <p class="command">
              <span aria-hidden="true">❯</span> <code>llm-usage monthly --by-machine</code>
            </p>
            <table>
              <thead>
                <tr>
                  <th scope="col">Source</th>
                  <th scope="col">Tokens</th>
                  <th scope="col">Cost (USD)</th>
                </tr>
              </thead>
              <tbody>
                {machineRows.map((row) => (
                  <tr>
                    <th scope="row">{row.label}</th>
                    <td>{row.tokens}</td>
                    <td>{row.cost}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <section class="section" aria-labelledby="reports-title">
        <div class="section-heading">
          <h2 id="reports-title">Start with what you want to know.</h2>
          <a class="text-link" href={link('reports')}>
            All reports →
          </a>
        </div>
        <div class="report-grid">
          {reports.map((report) => (
            <a class="report-card" href={link(report.slug)}>
              <div class="card-top">
                <span class="card-name">{report.name}</span>
                <span aria-hidden="true">↗</span>
              </div>
              <h3>{report.question}</h3>
              <p>{report.detail}</p>
              <code>{report.command ? `llm-usage ${report.command}` : 'llm-usage'}</code>
            </a>
          ))}
        </div>
        <p class="more-reports">
          Does usage line up with your commits? <a href={link('efficiency')}>Check efficiency</a>.
          Want a year in review? <a href={link('wrapped')}>Try Wrapped</a>. Need individual events?{' '}
          <a href={link('events')}>Export JSONL or CSV</a>.
        </p>
      </section>

      <section class="section inside" aria-labelledby="inside-title">
        <div class="section-heading">
          <div>
            <h2 id="inside-title">A parsing library under a reporting CLI.</h2>
            <p>
              The {sources.length} source adapters live in <code>@ayagmar/agent-sessions</code>, a
              package with no runtime dependencies that finds the logs, reads them, and yields one
              event shape. The CLI adds the event store, pricing, other machines, and the reports.
            </p>
          </div>
          <div class="inside-links">
            <a class="text-link" href={link('architecture')}>
              Read the architecture →
            </a>
            <a class="text-link" href={link('library')}>
              Use the library →
            </a>
          </div>
        </div>
        <div class="diagrams">
          <PackageLayers />
          <EventFlow />
        </div>
      </section>

      <section class="section principles" aria-labelledby="principles-title">
        <div>
          <h2 id="principles-title">
            Useful numbers.
            <br />
            Visible limits.
          </h2>
          <p class="summary">
            Usage reports help you understand your tools. Source logs, pricing coverage, and
            attribution determine what each number can tell you.
          </p>
          <a class="text-link" href={link('pricing')}>
            How pricing works →
          </a>
        </div>
        <dl>
          <div>
            <dt>Your sessions stay on your machines</dt>
            <dd>
              Parsing and reporting happen on your machines, and other machines are reached only
              over your own ssh. Online runs fetch pricing and check npm for updates; neither
              request includes your usage. <a href={link('privacy')}>Read the privacy page</a>.
            </dd>
          </div>
          <div>
            <dt>Cost coverage is explicit</dt>
            <dd>
              Source-recorded cost is kept. Other events use available model pricing. A tilde marks
              partial cost; a dash means unresolved cost. Estimates may differ from your bill.
            </dd>
          </div>
          <div>
            <dt>Keep the data useful outside the terminal</dt>
            <dd>
              Export versioned JSON, Markdown, normalized events, or an interactive HTML report.
              Diagnostics stay separate from report data.{' '}
              <a href={link('output-formats')}>Choose an output format</a>.
            </dd>
          </div>
        </dl>
      </section>

      <section class="section quickstart" aria-labelledby="quickstart-title">
        <div>
          <h2 id="quickstart-title">Your first report is one command away.</h2>
          <p>Try it without installing. Standard source locations are discovered automatically.</p>
          <a class="button primary" href={link('getting-started')}>
            Open the setup guide →
          </a>
        </div>
        <div class="quickstart-code">
          <span class="code-label">Try it now</span>
          <div class="install">
            <code>npx --yes llm-usage-metrics@latest</code>
            <button
              type="button"
              data-copy="npx --yes llm-usage-metrics@latest"
              aria-label="Copy quickstart command"
            >
              Copy
            </button>
          </div>
          <p>Already installed, but seeing an empty report?</p>
          <code>llm-usage doctor</code>
          <a class="text-link" href={link('troubleshooting')}>
            Find the cause →
          </a>
        </div>
      </section>
      <p class="sr-only" role="status" data-copy-status></p>
    </main>
    <footer class="shell footer">
      <a class="brand" href={base}>
        llm-usage-metrics
      </a>
      <nav aria-label="Footer">
        <a href={link('docs')}>Documentation</a>
        <a href={link('cli-reference')}>CLI reference</a>
        <a href={link('library')}>Library</a>
        <a href={link('privacy')}>Privacy</a>
        <a href={`${base}llms.txt`}>llms.txt</a>
        <a href={link('benchmarks')}>Benchmarks</a>
        <a href={github}>GitHub</a>
        <a href="https://www.npmjs.com/package/llm-usage-metrics">npm</a>
      </nav>
      <p>Built for the logs you already have. MIT licensed.</p>
    </footer>

    <script>
      const toggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
      const demoReport = document.querySelector<HTMLIFrameElement>('[data-demo-report]');

      // The demo report reads its theme from the URL hash (`theme=light|dark`), so it follows
      // this page's theme and keeps the rest of the visitor's view when the theme changes.
      function withTheme(hash: string, theme: string) {
        const fields = hash
          .replace(/^#/, '')
          .split('&')
          .filter((field) => field !== '' && !field.startsWith('theme='));
        return `#${[...fields, `theme=${theme}`].join('&')}`;
      }
      function syncDemoTheme(theme: string) {
        const view = demoReport?.contentWindow?.location;
        if (!demoReport || !view) return;
        // Until the report loads, the frame still shows its first blank page, and setting src
        // replaces it. Afterwards location.replace keeps the visitor's history clean.
        if (view.href === 'about:blank') {
          demoReport.src = `${demoReport.dataset.src}${withTheme('', theme)}`;
        } else {
          view.replace(`${view.pathname}${withTheme(view.hash, theme)}`);
        }
      }

      function updateThemeControl() {
        const dark = document.documentElement.dataset.theme === 'dark';
        toggle?.setAttribute('aria-label', dark ? 'Use light theme' : 'Use dark theme');
        document
          .querySelector('meta[name="theme-color"]')
          ?.setAttribute('content', dark ? '#11130f' : '#f5f2ea');
      }
      toggle?.addEventListener('click', () => {
        const theme = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = theme;
        try {
          localStorage.setItem('starlight-theme', theme);
        } catch {
          /* Theme still works without storage. */
        }
        updateThemeControl();
        syncDemoTheme(theme);
      });
      updateThemeControl();
      syncDemoTheme(document.documentElement.dataset.theme ?? 'dark');
      for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
        let timeout: ReturnType<typeof setTimeout>;
        button.addEventListener('click', async () => {
          const status = document.querySelector('[data-copy-status]');
          try {
            await navigator.clipboard.writeText(button.dataset.copy!);
            button.textContent = 'Copied';
            if (status) status.textContent = 'Command copied.';
          } catch {
            button.textContent = 'Try selecting';
            if (status) status.textContent = 'Unable to copy. Select and copy the command text.';
          }
          clearTimeout(timeout);
          timeout = setTimeout(() => {
            button.textContent = 'Copy';
          }, 2500);
        });
      }
    </script>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }
  :global(html) {
    color-scheme: dark;
    scroll-behavior: smooth;
    background: var(--color-bg);
  }
  :global(html[data-theme='light']) {
    color-scheme: light;
  }
  :global(body) {
    margin: 0;
    color: var(--color-text);
    font-family: var(--font-sans);
    line-height: 1.6;
  }
  :global(::selection) {
    background: var(--color-accent-subtle);
  }
  :global(:focus-visible) {
    outline: 2px solid var(--color-accent);
    outline-offset: 5px;
  }
  a {
    color: inherit;
    text-decoration: none;
  }
  button {
    font: inherit;
    cursor: pointer;
  }
  .shell {
    max-width: 1280px;
    margin-inline: auto;
    padding-inline: clamp(1.25rem, 4vw, 3rem);
  }
  .header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    min-height: 90px;
    gap: 1rem;
    border-bottom: 1px solid var(--border-default);
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    font-family: var(--font-mono);
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: -0.03em;
  }
  nav {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    font-size: 0.86rem;
    color: var(--color-text-muted);
  }
  nav a:hover,
  .text-link:hover {
    color: var(--color-accent-hover);
  }
  .theme-toggle {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 1px solid var(--border-default);
    border-radius: 50%;
    background: var(--color-bg-card);
    color: var(--color-text);
  }
  .theme-toggle:hover {
    border-color: var(--border-strong);
  }
  .skip-link {
    position: fixed;
    top: 1rem;
    left: 1rem;
    z-index: 10;
    padding: 0.7rem 1rem;
    background: var(--color-accent);
    color: var(--color-accent-ink);
    transform: translateY(-200%);
  }
  .skip-link:focus {
    transform: none;
  }
  .hero {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3.5rem;
    align-items: center;
    padding-block: 5rem 4.5rem;
  }
  .release {
    display: inline-flex;
    gap: 0.6rem;
    align-items: center;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    border-bottom: 1px solid var(--border-strong);
    padding-bottom: 0.5rem;
    margin-bottom: 2.2rem;
  }
  .release > span:first-child {
    color: var(--color-accent);
    font-size: 0.6rem;
  }
  .code-label,
  .card-name {
